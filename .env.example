# Copy this file to .env and fill in only what you need.
# Anything left blank falls back to a safe local default.

# --- Provider selection ------------------------------------------------
LLM_PROVIDER=local          # local | azure  | openai | ollama
STORAGE_PROVIDER=local      # local | azure  (azure = Cosmos DB)
AUTH_PROVIDER=none          # none  | azure  (azure = Entra ID OIDC)
BLOB_PROVIDER=local         # local | azure  (transcripts / uploads backend)
SPEECH_PROVIDER=none        # none  | azure  | openai
SEARCH_PROVIDER=none        # none  | bing   | duckduckgo
IMAGE_PROVIDER=none         # none  | local  | azure

# --- Secret key (REQUIRED for PAT encryption + sessions) --------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Project content source (optional) --------------------------------
# Override the host path mounted at /data/projects in the backend.
# Defaults to ./projects when unset. See compose.yaml for examples.
# PROJECTS_SOURCE=../my-content-repo
# PROJECTS_SOURCE=/path/to/content

# --- GitHub source access (optional) ----------------------------------
# Needed only when attaching private GitHub repositories as engagement
# sources. Public repositories work without a token.
GITHUB_TOKEN=

# --- GitHub OAuth (optional) -------------------------------------------
# Local runtime values only. Do not commit real credentials.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/github/oauth/callback
GITHUB_OAUTH_SCOPE=read:user repo

# --- Service principal for DefaultAzureCredential (any *_PROVIDER=azure)
# Leave the API keys below blank when these are set; the SDK will use
# DefaultAzureCredential and pick up the SP automatically.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Azure OpenAI (LLM_PROVIDER=azure) --------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- OpenAI direct / compatible APIs (LLM_PROVIDER=openai) ------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

# --- OpenAI-compatible transcription (SPEECH_PROVIDER=openai) ---------
# OPENAI_TRANSCRIPTION_API_KEY falls back to OPENAI_API_KEY when blank.
# Use any transcription model supported by the selected endpoint.
OPENAI_TRANSCRIPTION_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_TRANSCRIPTION_BASE_URL=

# --- Ollama (LLM_PROVIDER=ollama) -------------------------------------
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# --- Cosmos DB (STORAGE_PROVIDER=azure) -------------------------------
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=core-discovery
COSMOS_ENSURE_COLLECTIONS=true
# IMMUTABLE per Cosmos container -- set before first ensure_collections run.
COSMOS_PARTITION_STRATEGY=id

# --- Azure Blob Storage (BLOB_PROVIDER=azure) -------------------------
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=transcripts

# --- Azure Speech (SPEECH_PROVIDER=azure) -----------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_RESOURCE_ID=

# --- Bing search (SEARCH_PROVIDER=bing) -------------------------------
BING_SEARCH_API_KEY=

# --- CORS --------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]

# --- Mount paths inside the container (do not change unless you know why)
PROJECTS_ROOT=/data/projects
EXTENSIONS_DIR=/data/extensions
CUSTOMERS_WORKSPACE_ROOT=/data/customers

# --- Host path mounted at /data/storage --------------------------------
# Persists backend local data on the host (cache, local storage provider,
# downloaded repo sources).
LOCAL_DATA_PATH=./data

# --- Host path mounted at /data/customers ------------------------------
# Persists customer workspaces on the host.
CUSTOMERS_WORKSPACE_PATH=./data/customers
